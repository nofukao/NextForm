<?php
/*
 * 検索インデックスと実際のページを突き合わせ、ずれを報告する。
 *
 *   php NextForm/app/tool/search_index_check /path/to/wiki/index.php [オプション]
 *
 *     --list <件数>  ずれたページ名を最大何件まで表示するか (既定 20、0 で全件)
 *     --quiet        問題が無ければ何も表示しない
 *     --deep         ページごとに ngram を突き合わせる (下記)
 *     --user <名前>  --deep で本文を読むときに使う管理者ユーザー名
 *
 * 既定の検査は「索引に載っているページ」と「実在するページ」の集合を比べる。
 * これは速いが、**部分的な破損は見つけられない**。索引は 1 ページ分の ngram が
 * 複数のファイルに分かれて入るため、1 ファイルが失われてもページ自体は
 * 他のファイルに残り、集合としては一致してしまう。実際に起きる壊れ方は
 * この部分的な破損なので、疑わしいときは --deep を使う。
 *
 * --deep は全ページの本文を読み直して ngram を作り直し、索引と 1 件ずつ
 * 突き合わせる。再構築と同じだけ時間がかかる (1000 ページで 30 秒程度)。
 * 読み取りに権限が要るサイトでは --user に管理者名を渡すこと。
 *
 * **読み取り専用**。storage/ には一切書き込まない。
 *
 * 検索インデックスは storage/cache/ に 2-gram の転置表として持たれていて、
 * ページの保存・削除のたびに「旧本文と新本文の差分」だけが適用される。
 * この差分は索引の中身を確認せずに適用されるため、更新が一度でも失われると
 * 索引と本文がずれたまま固定され、以後どれだけ編集しても直らない。
 * 症状は「特定の語だけ検索に出てこない」で、画面にもログにも何も出ない。
 *
 * このツールはその状態を検出する。直すには管理画面の
 * 「検索インデックスの再構築」を実行する。
 *
 * 終了コード: 0 = 問題なし / 1 = ずれあり / 2 = 使い方の誤り
 */

$argv = $_SERVER['argv'];

function usage() {
    fprintf(STDERR, "Usage: php search_index_check <path/to/wiki/index.php> [--list <n>] [--quiet]\n");
    fprintf(STDERR, "                             [--deep] [--user <name>]\n");
    exit(2);
}

if(count($argv) < 2)
    usage();

$index_path = $argv[1];
$list_max = 20;
$is_quiet = false;
$is_deep = false;
$user = '';

for($i = 2; $i < count($argv); $i++) {
    switch($argv[$i]) {
    case '--list':
	if(!isset($argv[$i + 1]))
	    usage();
	$list_max = (int)$argv[++$i];
	break;
    case '--quiet':
	$is_quiet = true;
	break;
    case '--deep':
	$is_deep = true;
	break;
    case '--user':
	if(!isset($argv[$i + 1]))
	    usage();
	$user = $argv[++$i];
	break;
    default:
	usage();
    }
}

require_once(dirname(__FILE__) . '/common');
eval_index_php($index_path);
define('APP_DIR_PATH', dirname(dirname(__FILE__)));
require_once(APP_DIR_PATH . '/main.inc');

if($is_deep) {
    /*
     * --deep は本文を読み直す。CLI にはセッションが無く auth_get_user() が
     * false を返すため、読み取りに権限が要るサイトでは弾かれる。
     * deploy/scripts/gen-pages.php と同じ方法で管理者を差し込む。
     */
    if($user !== '')
	$GLOBALS['AUTH_GET_USER_CACHE'] = array('name' => $user, 'method' => 'digest');
    /*
     * 本文の変換は &pre(code) などで head_tags_add_javascript() を呼ぶ。
     * CLI では $head_tags が未初期化のままだと Fatal error になる。
     */
    head_tags_init();
}

$out = array();
function report($format) {
    global $out;
    $args = array_slice(func_get_args(), 1);
    $out[] = vsprintf($format, $args);
}

function report_flush($is_quiet, $has_problem) {
    global $out;
    if($is_quiet && !$has_problem)
	return;
    foreach($out as $line)
	printf("%s\n", $line);
}

function report_pagenames($pagenames, $list_max) {
    $n = 0;
    foreach($pagenames as $pagename => $dummy) {
	if($list_max !== 0 && $n >= $list_max) {
	    report("\t... 他 %d 件", count($pagenames) - $n);
	    break;
	}
	report("\t%s", $pagename);
	$n++;
    }
}

report('検索インデックスの検査: %s', $index_path);

/*
 * SEARCH_ENGINE は 1.3.10 で入った定数。それ以前の ToraToraWiki には無く、
 * 内蔵の 2-gram インデックスしか選択肢が無い。アップグレード前のサイトを
 * そのまま検査できるようにしたいので、定数の有無で分岐する。
 */
if(defined('SEARCH_ENGINE') && SEARCH_ENGINE !== 'builtin') {
    report('SEARCH_ENGINE = %s のため、内蔵インデックスは使われていない。検査するものが無い。',
	   SEARCH_ENGINE);
    report_flush($is_quiet, false);
    exit(0);
}

/*
 * 索引側。cache_get() は「ファイルが無い」も「開けない」も false を返すので、
 * まず生データを取り、unserialize に失敗したものだけを「壊れている」として数える。
 * 壊れたバケットは、次に誰かがページを保存した時点で中身が 1 ページ分に
 * 置き換わる (search_index_add() が読めなかった索引を空とみなすため) ので、
 * 検出できたら再構築を促す。
 */
$cachekeys = cache_get_keys_prefix('', 'search_index_');
$indexed_pages = array();
$page_ngrams = array();     /* --deep のときだけ埋める: ページ名 => ngram の集合 */
$broken_keys = array();
$ngram_num = 0;
$posting_num = 0;
$total_bytes = 0;

foreach($cachekeys as $cachekey) {
    $filepath = cache_get_as_filepath('', $cachekey);
    if($filepath !== false)
	$total_bytes += filesize($filepath);

    $data = cache_get('', $cachekey);
    if($data === false) {
	$broken_keys[$cachekey] = '読めない';
	continue;
    }
    $index = @unserialize($data);
    if($index === false) {
	$broken_keys[$cachekey] = sprintf('壊れている (%d バイト)', strlen($data));
	continue;
    }
    foreach($index as $ngram => $pagenames) {
	$ngram_num++;
	foreach($pagenames as $pagename => $dummy) {
	    /* ページ名が数字だけだと PHP の配列キーが整数になるので文字列に戻す */
	    $pagename = (string)$pagename;
	    $indexed_pages[$pagename] = true;
	    if($is_deep)
		$page_ngrams[$pagename][$ngram] = true;
	    $posting_num++;
	}
    }
}

/* 実ページ側。索引を作る option/search_index.inc と同じ取り方をする */
$real_pages = array();
foreach(page_find('', array('is_pagename_only' => true)) as $page)
    $real_pages[$page['name']] = true;

$missing = array_diff_key($real_pages, $indexed_pages);
$ghosts  = array_diff_key($indexed_pages, $real_pages);
$has_problem = !empty($broken_keys) || !empty($missing) || !empty($ghosts);

report('');
report('索引ファイル      : %d 個 / %.2f MB', count($cachekeys), $total_bytes / 1048576);
report('ngram 種類        : %d', $ngram_num);
report('posting 総数      : %d', $posting_num);
report('索引上のページ数  : %d', count($indexed_pages));
report('実際のページ数    : %d', count($real_pages));
report('');

if(!empty($broken_keys)) {
    report('[異常] 読めない索引ファイルが %d 個ある。', count($broken_keys));
    report('       この状態で誰かがページを保存すると、そのファイルの中身が');
    report('       保存したページ 1 件分だけに置き換わり、他のページが検索に出なくなる。');
    foreach($broken_keys as $cachekey => $reason)
	report("\t%s: %s", $cachekey, $reason);
    report('');
}

if(!empty($missing)) {
    report('[異常] 索引に載っていないページが %d 件ある。', count($missing));
    report('       これらのページは本文に何が書かれていても検索に出てこない。');
    report_pagenames($missing, $list_max);
    report('');
}

if(!empty($ghosts)) {
    report('[異常] 実在しないページが索引に %d 件残っている。', count($ghosts));
    report('       検索のたびに無駄な読み込みが起き、PHP の警告も出る。');
    report_pagenames($ghosts, $list_max);
    report('');
}

/*
 * ここから --deep。ページごとに、本文から作り直した ngram と索引の中身を比べる。
 * 索引は 1 ページ分の ngram を複数のファイルに分けて持つので、ファイルが
 * 1 つ失われてもページ自体は他のファイルに残る。上の集合比較では見つからない
 * この「部分的な欠け」が、実際に起きる壊れ方そのものになる。
 */
if($is_deep) {
    $partial = array();
    $stale = array();
    foreach($real_pages as $pagename => $dummy) {
	$page = page_read($pagename);
	$should = search_page_ngram($page);
	$actual = isset($page_ngrams[$pagename]) ? $page_ngrams[$pagename] : array();
	$lack = count(array_diff_key($should, $actual));
	$over = count(array_diff_key($actual, $should));
	if($lack > 0)
	    $partial[$pagename] = $lack;
	if($over > 0)
	    $stale[$pagename] = $over;
    }

    if(!empty($partial)) {
	$has_problem = true;
	report('[異常] 索引の ngram が欠けているページが %d 件ある。', count($partial));
	report('       これらのページは、本文に含まれる語の一部で検索しても出てこない。');
	$n = 0;
	foreach($partial as $pagename => $lack) {
	    if($list_max !== 0 && $n >= $list_max) {
		report("\t... 他 %d 件", count($partial) - $n);
		break;
	    }
	    report("\t%s (%d 個不足)", $pagename, $lack);
	    $n++;
	}
	report('');
    }

    if(!empty($stale)) {
	$has_problem = true;
	report('[異常] 本文に無い ngram が残っているページが %d 件ある。', count($stale));
	report('       検索に余計なページが出るわけではないが (本文で照合し直すため)、');
	report('       索引が本文とずれている証拠になる。');
	$n = 0;
	foreach($stale as $pagename => $over) {
	    if($list_max !== 0 && $n >= $list_max) {
		report("\t... 他 %d 件", count($stale) - $n);
		break;
	    }
	    report("\t%s (%d 個余分)", $pagename, $over);
	    $n++;
	}
	report('');
    }

    if(empty($partial) && empty($stale))
	report('ページごとの ngram 突き合わせ: %d 件すべて一致。', count($real_pages));
}

if($has_problem)
    report('=> 管理画面の「検索インデックスの再構築」を実行すること。');
else
    report('=> 問題なし。索引と実際のページは一致している。');

report_flush($is_quiet, $has_problem);
exit($has_problem ? 1 : 0);
?>
