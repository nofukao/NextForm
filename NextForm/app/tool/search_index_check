<?php
/*
 * 検索インデックスと実際のページを突き合わせ、ずれを報告する。
 *
 *   php NextForm/app/tool/search_index_check /path/to/wiki/index.php [オプション]
 *
 *     --list <件数>  ずれたページ名を最大何件まで表示するか (既定 20、0 で全件)
 *     --quiet        問題が無ければ何も表示しない
 *     --deep         ページごとに ngram を突き合わせる (下記)
 *     --user <名前>  --deep / --repair で本文を読むときに使う管理者ユーザー名
 *     --repair <ページ名>  そのページの ngram を入れ直す (下記)
 *
 * `--repair` 以外は**読み取り専用**。storage/ には一切書き込まない。
 *
 * 既定の検査は「索引に載っているページ」と「実在するページ」の集合を比べる。
 * これは速いが、**部分的な破損は見つけられない**。索引は 1 ページ分の ngram が
 * 複数のファイルに分かれて入るため、1 ファイルが失われてもページ自体は
 * 他のファイルに残り、集合としては一致してしまう。実際に起きる壊れ方は
 * この部分的な破損なので、疑わしいときは --deep を使う。
 *
 * --deep は全ページの本文を読み直して ngram を作り直し、索引と 1 件ずつ
 * 突き合わせる。実測で wiki ページ 1 件あたり約 1.8ms (967 ページで 0.77 秒)。
 * 読み取りに権限が要るサイトでは --user に管理者名を渡すこと。
 *
 * --repair は --deep が見つけたページを、全体の再構築なしに直す。
 * 保存時の索引更新は「旧本文と新本文の差分」しか当てないため、一度失われた
 * 登録は編集を繰り返しても戻らない。--repair は差分ではなく全 ngram を
 * 入れ直すので確実に戻る。
 *
 * 終了コード: 0 = 問題なし / 1 = ずれあり / 2 = 使い方の誤り
 */

$argv = $_SERVER['argv'];

function usage() {
    fprintf(STDERR, "Usage: php search_index_check <path/to/wiki/index.php> [--list <n>] [--quiet]\n");
    fprintf(STDERR, "                             [--deep] [--user <name>] [--repair <pagename>]\n");
    exit(2);
}

if(count($argv) < 2)
    usage();

$index_path = $argv[1];
$list_max = 20;
$is_quiet = false;
$is_deep = false;
$user = '';
$repair_pagename = '';

for($i = 2; $i < count($argv); $i++) {
    switch($argv[$i]) {
    case '--list':
	if(!isset($argv[$i + 1]))
	    usage();
	$list_max = (int)$argv[++$i];
	break;
    case '--quiet':
	$is_quiet = true;
	break;
    case '--deep':
	$is_deep = true;
	break;
    case '--user':
	if(!isset($argv[$i + 1]))
	    usage();
	$user = $argv[++$i];
	break;
    case '--repair':
	if(!isset($argv[$i + 1]))
	    usage();
	$repair_pagename = $argv[++$i];
	break;
    default:
	usage();
    }
}

require_once(dirname(__FILE__) . '/common');
eval_index_php($index_path);
define('APP_DIR_PATH', dirname(dirname(__FILE__)));
require_once(APP_DIR_PATH . '/main.inc');

if($is_deep || $repair_pagename !== '') {
    /*
     * 本文を読み直す。CLI にはセッションが無く auth_get_user() が false を
     * 返すため、読み取りに権限が要るサイトでは弾かれる。
     * deploy/scripts/gen-pages.php と同じ方法で管理者を差し込む。
     */
    if($user !== '')
	$GLOBALS['AUTH_GET_USER_CACHE'] = array('name' => $user, 'method' => 'digest');
    /*
     * 本文の変換は &pre(code) などで head_tags_add_javascript() を呼ぶ。
     * CLI では $head_tags が未初期化のままだと Fatal error になる。
     */
    head_tags_init();
}

/*
 * SEARCH_ENGINE は 1.3.10 で入った定数。それ以前の ToraToraWiki には無く、
 * 内蔵の 2-gram インデックスしか選択肢が無い。アップグレード前のサイトを
 * そのまま検査できるようにしたいので、定数の有無で分岐する。
 */
if(defined('SEARCH_ENGINE') && SEARCH_ENGINE !== 'builtin') {
    printf("SEARCH_ENGINE = %s のため、内蔵インデックスは使われていない。検査するものが無い。\n",
	   SEARCH_ENGINE);
    exit(0);
}

if($repair_pagename !== '') {
    printf("入れ直し: %s .. ", $repair_pagename);
    if(search_index_repair($repair_pagename)) {
	printf("done.\n");
	exit(0);
    }
    printf("failed. (ページがありません)\n");
    exit(1);
}

$out = array();
function report($format) {
    global $out;
    $args = array_slice(func_get_args(), 1);
    $out[] = vsprintf($format, $args);
}

/* $counts が空でなければ、見出しと説明を出したうえでページ名を並べる */
function report_pages($title, $notes, $counts, $unit, $list_max) {
    report('[異常] %s', $title);
    foreach($notes as $note)
	report('       %s', $note);
    $n = 0;
    foreach($counts as $pagename => $count) {
	if($list_max !== 0 && $n >= $list_max) {
	    report("\t... 他 %d 件", count($counts) - $n);
	    break;
	}
	if($unit === '')
	    report("\t%s", $pagename);
	else
	    report("\t%s (%d %s)", $pagename, $count, $unit);
	$n++;
    }
    report('');
}

$check = search_index_check($is_deep);

report('検索インデックスの検査: %s', $index_path);
report('');
report('索引ファイル      : %d 個 / %.2f MB', $check['file_num'], $check['bytes'] / 1048576);
report('ngram 種類        : %d', $check['ngram_num']);
report('posting 総数      : %d', $check['posting_num']);
report('索引上のページ数  : %d', count($check['indexed_pages']));
report('実際のページ数    : %d', $check['page_num']);
report('');

if(!empty($check['broken']))
    report_pages(
	sprintf('読めない索引ファイルが %d 個ある。', count($check['broken'])),
	array('このファイルに入っていたページは検索に出てこない。',
	      '再構築すると作り直される。'),
	$check['broken'], '', $list_max);

if(!empty($check['missing']))
    report_pages(
	sprintf('索引に載っていないページが %d 件ある。', count($check['missing'])),
	array('これらのページは本文に何が書かれていても検索に出てこない。'),
	$check['missing'], '', $list_max);

if(!empty($check['ghosts']))
    report_pages(
	sprintf('実在しないページが索引に %d 件残っている。', count($check['ghosts'])),
	array('検索のたびに、消えたページを読みに行く無駄が起きる。'),
	$check['ghosts'], '', $list_max);

if(!empty($check['partial']))
    report_pages(
	sprintf('索引の ngram が欠けているページが %d 件ある。', count($check['partial'])),
	array('これらのページは、本文に含まれる語の一部で検索しても出てこない。',
	      '--repair <ページ名> で 1 件ずつ直せる。'),
	$check['partial'], '個不足', $list_max);

if(!empty($check['stale']))
    report_pages(
	sprintf('本文に無い ngram が残っているページが %d 件ある。', count($check['stale'])),
	array('検索に余計なページが出るわけではないが (本文で照合し直すため)、',
	      '索引が本文とずれている証拠になる。'),
	$check['stale'], '個余分', $list_max);

if($check['is_deep']) {
    if(empty($check['partial']) && empty($check['stale']))
	report('ページごとの ngram 突き合わせ: %d 件すべて一致。', $check['page_num']);
} else {
    report('※ 既定の検査ではページごとの部分的な欠けは分からない。--deep で調べられる。');
}

if($check['is_ok'])
    report('=> 問題なし。索引と実際のページは一致している。');
else
    report('=> 管理画面の「検索インデックスの再構築」を実行すること。');

if(!$is_quiet || !$check['is_ok']) {
    foreach($out as $line)
	printf("%s\n", $line);
}
exit($check['is_ok'] ? 0 : 1);
?>
