<?php
$argv = $_SERVER['argv'];
if(count($argv) < 2) {
    printf("Usage: %s /path/to/wiki/index.php [--delete-find-cache]\n", $argv[0]);
    exit(1);
}

require_once(dirname(__FILE__) . '/common');
eval_index_php($argv[1]);
define('APP_DIR_PATH', dirname(dirname(__FILE__)));
require_once(APP_DIR_PATH . '/main.inc');

printf("update wiki %s\n", $argv[1]);

printf("\tdelete helper cache .. ");
cache_delete('', 'wiki-helper-info');
printf("done.\n");

/*
 * 0.6.0 以前に焼き付けたマニュアルのページを片付ける (manual.inc を参照)。
 * アップグレードの手作業手順ではこのツールが唯一の後始末の機会になる。
 */
/*
 * 本文の変換は &pre(code) などで head_tags_add_javascript() を呼ぶ。
 * CLI では $head_tags が未初期化のままだと Fatal error になる
 * (app/tool/search_index_check と同じ理由)。
 */
head_tags_init();

printf("\tclean up generated manual pages .. ");
$manual_kept = array();
$manual_removed = manual_cleanup_generated($manual_kept);
printf("%d removed", $manual_removed);
if(count($manual_kept) > 0)
    printf(", %d kept (edited): %s", count($manual_kept), implode(' ', $manual_kept));
printf(".\n");

if(isset($argv[2]) && $argv[2] == '--delete-find-cache') {
    printf("\tdelete find cache .. ");
    cache_delete('', 'page_find_');
    $pages = page_find('', array('is_pagename_only' => true));
    foreach($pages as $page) {
	cache_delete($page['name'], 'page_find_');
    }
    printf("done.\n");
}

printf("\ttheme [%s] .. ", THEME);
if(theme_convert(THEME))
    printf("done.\n");
else
    printf("failed.\n");

?>
