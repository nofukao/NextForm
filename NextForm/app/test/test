EOF;
    $result = template_replace_placeholders_by_input($template, $args);
    test_eq($result, $answer);

    $result = template_get_regex_pattern($template);
    $answer = <<<'EOF'
(.*)
(.*)
((?s).*)
((?:(?m)^\-.*\n?)*)
((?s).*?)
((?:(?m)^ .*\n?)*)
((?s).*?)
((?s).*)
EOF;
    test_eq($result, $answer);
}

function test_eq($a, $b, $name = 'equals') {
    $a_str = test_var_dump($a);
    $b_str = test_var_dump($b);
    if(is_string($a) && is_string($b) &&
       strpos($a, "\n") == false && strpos($b, "\n") == false ) {
	$message = "\t" . $a_str . "\t" . $b_str;
    } else {
	$a_lines = explode("\n", $a_str);
	$b_lines = explode("\n", $b_str);
	$diff = diff($a_lines,$b_lines);
	$message = '';
	foreach($diff as $d) {
	    if($d['change'] === 'add')
		$message .= '>' . $d['string'] . "\n";
	    else if($d['change'] === 'delete')
		$message .= '<' . $d['string'] . "\n";
	}
    }

    if($a === $b)
	test_ok('test ok: ' . $name .  "\n" . $message);
    else
	test_error('test failed: ' . $name .  "\n" . $message);
}

function test_eq_diff($a, $b, $name = 'equals') {
    $a_str = test_var_dump($a);
    $b_str = test_var_dump($b);
    $a_lines = explode("\n", $a_str);
    $b_lines = explode("\n", $b_str);

    if($a === $b)
	test_ok('test ok: ' . $name .  "\n" . $message);
    else
	test_error('test failed: ' . $name .  "\n" . $message);
}

function test_ok($msg = '') {
