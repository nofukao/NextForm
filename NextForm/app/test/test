function test_page_path() {
    $tests = array(
	// base, path, answer
	'',           	    '',               '',
	'',           	    '.',              '',
	'',           	    '..',             '',
	'',           	    'hoge',           'hoge',
	'',   	            '../../hoge',     'hoge',

	'hoge',        	    '',               '',
	'hoge',       	    '.',              'hoge',
	'hoge',       	    'foo',            'foo',
	'hoge',        	    'hoge',           'hoge',
	'hoge',       	    'foo/bar',        'foo/bar',
	'hoge',       	    './bar',          'hoge/bar',
	'hoge',       	    '././bar',        'hoge/bar',
	'hoge',       	    '../bar',         'bar',
	'hoge',       	    '../../bar',      'bar',
	'hoge',       	    '../../bar/a',    'bar/a',

	'hoge/foo',    	    '',               '',
	'hoge/foo',   	    '.',              'hoge/foo',
	'hoge/foo',    	    'hoge',           'hoge',
	'hoge/foo',  	    'foo',            'foo',
	'hoge/foo',   	    '..',             'hoge',
	'hoge/foo',   	    '../..',          '',
	'hoge/foo',   	    './a',            'hoge/foo/a',
	'hoge/foo',   	    '../a',           'hoge/a',
	'hoge/foo',   	    '../../a',        'a',
	'hoge/foo',   	    './a/..',         'hoge/foo',
	'hoge/foo',   	    './a/../..',      'hoge',
	'hoge/foo',   	    './a/../../..',   '',
	);
    for($i = 0; $i < count($tests) / 3; $i++) {
	$base = $tests[$i * 3];
	$path = $tests[$i * 3 + 1];
	$answer = $tests[$i * 3 + 2];
	$result = page_path_to_pagename($path, $base, false);
	$name = sprintf('page_path_to_pagename(%s, %s, false): %s', $path, $base, $result);
	test_eq($result, $answer, $name);
    }

    $tests = array(
	// from , to
	'hoge', 'hoge',
	'hoge', 'hoge/foo',
	'hoge', 'hoge/foo/bar',
	'', 'hoge',
	'', 'hoge/foo',
	'Top', 'hoge',
	'A', 'hoge/foo',
	'hoge/foo', 'hoge',
	'hoge/foo/bar', 'hoge',
	'hoge/foo/bar', 'hoge/foo',
	'hoge/foo/bar', 'hoge/mochi',
	'hoge/foo/bar', '8',
	);
    for($i = 0; $i < count($tests) / 2; $i++) {
	$from = $tests[$i * 2];
	$to = $tests[$i * 2 + 1];
	$rel = page_relative_path($from, $to);
	$check = page_path_to_pagename($rel, $from, false);
	test_eq($check, $to, 'page_relative_path(' . $from . ',' . $to . '): ' . $rel);
    }
}

function test_wiki_tokens_is_whitespace() {
    $tests = array(
	// target, answer
	'',  true,
	' ', true,
	'   ', true,
	"\t", true,
	"\r", true,
	"\n", true,
	"\r\n", true,
	"\r\n \t", true,
	"\v", true,
	"\f", true,
	"\x00", true,
	"a", false,
	"b", false,
	"abc", false,
	" abc ", false,
	"\nabc\n", false,
	".", false,
	"*", false,
	"  a  ", false,
	"a  ", false,
	"  a", false,
	'\\', false,
	'\\\\', false,
	"\xff", false,
	);
    for($i = 0; $i < count($tests) / 2; $i++) {
	$target = $tests[$i * 2];
	$answer = $tests[$i * 2 + 1];
	$dummypage = array();
	$context = wiki_default_context($dummypage);
	$tokens = wiki_lex($context, $target);
	$result = wiki_tokens_is_whitespace($tokens);
	$name = sprintf('No.%d wiki_tokens_is_whitespace(%s): %s', $i, $target, trim(test_var_dump($result)));
	test_eq($result, $answer, $name);
    }
}    

function test_template_get_placeholders() {
    $template = <<<'EOF'
@p1@
@p2=defaultvalue2@
@p3'#@
@-p4#'@
`ignore`
@ p5#@
`multiline
ignore
`
@p6#=
multiline
default value
@
EOF;
    $answer = array(
	array(
	    'template' => '@p1@',
	    'index' => 0,
	    'type' => 'text',
	    'term' => 'p1',
	    ),
	array(
	    'template' => '@p2=defaultvalue2@',
	    'index' => 1,
	    'type' => 'text',
	    'value' => 'defaultvalue2',
	    'term' => 'p2',
	    ),
	array(
	    'template' => '@p3\'#@',
	    'index' => 2,
	    'type' => 'textarea',
	    'escape' => true,
	    'term' => 'p3',
	    ),
	array(
	    'template' => '@-p4#\'@',
	    'index' => 3,
	    'type' => 'textarea',
	    'escape' => true,
	    'wiki_line_head' => '-',
	    'wiki_operator' => 'list',
	    'term' => 'p4',
	    ),
	array(
	    'template' => '`ignore`',
	    'index' => 4,
	    'type' => 'ignore',
	    ),
	array(
	    'template' => '@ p5#@',
	    'index' => 5,
	    'type' => 'textarea',
	    'wiki_line_head' => ' ',
	    'wiki_operator' => 'pre',
	    'term' => 'p5',
	    ),
	array(
	    'template' => "`multiline\nignore\n`",
	    'index' => 6,
	    'type' => 'ignore',
	    ),
	array (
