}

function test_error($msg) {
    global $TEST_RESULTS;
    fprintf(STDERR, "test error: %s\n", $msg);
    $TEST_RESULTS['error']['count']++;
}

function test_var_dump($var) {
    ob_start();
    var_dump($var);
    $output = ob_get_contents();
    ob_end_clean();
    return $output;
}

