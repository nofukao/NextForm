    $WIKI_ENTITY_REFERENCES, $WIKI_ENTITY_IMAGES);

function wiki_operator_entity(&$context, $dom, $tree) {
    global $WIKI_ENTITY_IMAGES;
    if(!empty($WIKI_ENTITY_IMAGES[$tree->symbol])) {
	$i = dom_append_child($dom, 'i', 'entity ' . $tree->symbol);
	dom_append_text($i, $tree->symbol);
    } else {
	dom_append_ref($dom, $tree->symbol);
    }
}

function wiki_operator_entity_number(&$context, $dom, $tree) {
    $number = $tree->symbol;
    $is_success = false;
    
    if(preg_match('/^(\d+|x[\da-fA-F]+)$/', $number)) {
	$doc = new DOMDocument();
	if($doc->loadXML('<p>&#' . $number . ';</p>', LIBXML_NOERROR | LIBXML_NOWARNING)) {
	    dom_append_text($dom, $doc->firstChild->firstChild->wholeText);
	    $is_success = true;
	}
    }

    if(!$is_success)
	dom_append_error($dom, lf('Invalid format $text$', array('text' => $tree->symbol)));
}
