# テストの向け先。tests/env.local にコピーして使う。
#
#   cp tests/env.local.example tests/env.local
#
# env.local は Git に入らない (.gitignore 済み)。開発環境のホスト名や
# パスを公開リポジトリに書かずに済ませるための仕組み。
#
# 代入を ': "${VAR:=値}"' の形にしてあるのは、コマンドラインでの上書きを
# 効かせるため。次のように 1 回だけ別の向け先にできる:
#
#   BASE_URL=https://other.example.com/wiki ./tests/css-rules.sh

# --- golden.sh / smoke.sh / css-rules.sh の対象インスタンス ---
: "${BASE_URL:=http://localhost:8080}"

# --- upgrade.sh ---
# SRC_SITE  複製元にする既存の toratorawiki (このサイト自体は変更しない)
# TEST_SITE 検証用に作るサイトのパス
# TEST_URL  その URL
: "${SRC_SITE:=/var/www/html/tora2}"
: "${TEST_SITE:=/var/www/html/nf-upgrade-test}"
: "${TEST_URL:=http://localhost/nf-upgrade-test}"

# --- search-index.sh ---
# NF_SITE           複製元にする NextForm インスタンスのパス (このサイトは変更しない)
# SEARCH_TEST_SITE  検証用に作るサイトのパス (索引を壊すので必ず複製に対して行う)
: "${NF_SITE:=/var/www/html/nextform}"
: "${SEARCH_TEST_SITE:=/var/www/html/nf-search-test}"
# SEARCH_TEST_URL   そのサイトの URL (再構築をブラウザと同じ経路で走らせる検査が使う)
: "${SEARCH_TEST_URL:=http://localhost/nf-search-test}"

# --- csrf.sh ---
# CSRF_TEST_SITE  検証用に作るサイトのパス (権限を書き換えるので必ず複製に対して行う)
# CSRF_TEST_URL   そのサイトの URL。ヘッダを見る検査なので実際の HTTP が要る
: "${CSRF_TEST_SITE:=/var/www/html/nf-csrf-test}"
: "${CSRF_TEST_URL:=http://localhost/nf-csrf-test}"

# --- dispatch.sh ---
# DISPATCH_TEST_SITE  検証用に作るサイトのパス (権限を書き換えるので必ず複製に対して行う)
# DISPATCH_TEST_URL   そのサイトの URL
: "${DISPATCH_TEST_SITE:=/var/www/html/nf-dispatch-test}"
: "${DISPATCH_TEST_URL:=http://localhost/nf-dispatch-test}"

# --- search-cache.sh ---
# CACHE_TEST_SITE  検証用に作るサイトのパス (キャッシュを壊すので必ず複製に対して行う)
: "${CACHE_TEST_SITE:=/var/www/html/nf-cache-test}"

# --- ページを書き込むテストが使う管理者ユーザー名 ---
# setup-fixtures.sh と search-index.sh が page_write() の権限に使う。
# インストール時に決めた管理者名が admin 以外なら、ここで指定する。
# 合っていないと認証に失敗してページを 1 件も書けない。
# パスワードは不要 (CLI では認証結果のキャッシュに差し込むため)。
: "${WIKI_ADMIN:=admin}"

# --- PHP のエラーログ (smoke.sh / upgrade.sh が警告を数えるのに使う) ---
# PHP-FPM の既定。mod_php なら Apache のエラーログを指す
: "${PHP_ERROR_LOG:=/var/log/php-fpm/www-error.log}"

# --- theme-switch.sh ---
# THEME_TEST_SITE  検証用に作るサイトのパス (設定を書き換えるので必ず複製に対して行う)
# THEME_TEST_URL   そのサイトの URL
: "${THEME_TEST_SITE:=/var/www/html/nf-theme-test}"
: "${THEME_TEST_URL:=http://localhost/nf-theme-test}"

# --- manual.sh ---
# MANUAL_TEST_SITE  検証用に作るサイトのパス (権限を書き換えるので必ず複製に対して行う)
# MANUAL_TEST_URL   その URL
: "${MANUAL_TEST_SITE:=/var/www/html/nf-manual-test}"
: "${MANUAL_TEST_URL:=http://localhost/nf-manual-test}"

# --- syntax-survey.sh ---
# SURVEY_TEST_SITE  検証用に作るサイトのパス (ページを投入するので必ず複製に対して行う)
: "${SURVEY_TEST_SITE:=/var/www/html/nf-survey-test}"

# --- nav.sh ---
# NAV_TEST_SITE  検証用に作るサイトのパス (権限を書き換えるので必ず複製に対して行う)
# NAV_TEST_URL   そのサイトの URL
: "${NAV_TEST_SITE:=/var/www/html/nf-nav-test}"
: "${NAV_TEST_URL:=http://localhost/nf-nav-test}"
