# テストの向け先。tests/env.local にコピーして使う。
#
#   cp tests/env.local.example tests/env.local
#
# env.local は Git に入らない (.gitignore 済み)。開発環境のホスト名や
# パスを公開リポジトリに書かずに済ませるための仕組み。
#
# 代入を ': "${VAR:=値}"' の形にしてあるのは、コマンドラインでの上書きを
# 効かせるため。次のように 1 回だけ別の向け先にできる:
#
#   BASE_URL=https://other.example.com/wiki ./tests/css-rules.sh

# --- golden.sh / smoke.sh / css-rules.sh の対象インスタンス ---
: "${BASE_URL:=http://localhost:8080}"

# --- upgrade.sh ---
# SRC_SITE  複製元にする既存の toratorawiki (このサイト自体は変更しない)
# TEST_SITE 検証用に作るサイトのパス
# TEST_URL  その URL
: "${SRC_SITE:=/var/www/html/tora2}"
: "${TEST_SITE:=/var/www/html/nf-upgrade-test}"
: "${TEST_URL:=http://localhost/nf-upgrade-test}"

# --- PHP のエラーログ (smoke.sh / upgrade.sh が警告を数えるのに使う) ---
# PHP-FPM の既定。mod_php なら Apache のエラーログを指す
: "${PHP_ERROR_LOG:=/var/log/php-fpm/www-error.log}"
